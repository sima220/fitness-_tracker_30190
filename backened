def get_leaderboard_data(user_id, metric="total_minutes"):
    """Fetches leaderboard data for a user and their friends based on a metric."""
    conn, cur = None, None
    try:
        conn = get_db_connection()
        if not conn: return pd.DataFrame()
        cur = conn.cursor()

        # Get friend IDs including the user's own ID
        friend_ids = [user_id]
        friends_df = get_user_friends(user_id)
        if not friends_df.empty:
            friend_ids.extend(friends_df['ID'].tolist())

        # Calculate start and end of the current week (Sunday to Saturday)
        today = datetime.now().date()
        start_of_week = today - timedelta(days=today.weekday())
        end_of_week = start_of_week + timedelta(days=6)

        query = """
            SELECT
                u.name,
                SUM(w.duration_minutes) AS total_minutes
            FROM workouts w
            JOIN users u ON w.user_id = u.user_id
            WHERE u.user_id = ANY(%s) AND w.workout_date BETWEEN %s AND %s
            GROUP BY u.name
            ORDER BY total_minutes DESC;
        """
        cur.execute(query, (friend_ids, start_of_week, end_of_week))
        data = cur.fetchall()
        df = pd.DataFrame(data, columns=['Name', 'Total Workout Minutes (This Week)'])
        return df
    except (Exception, psycopg2.Error) as error:
        print(f"Error fetching leaderboard data: {error}")
        return pd.DataFrame()
    finally:
        if cur: cur.close()
        if conn: conn.close()

# --- Business Insights ---

def get_user_insights(user_id):
    """Provides business insights for a user's fitness data."""
    conn, cur = None, None
    try:
        conn = get_db_connection()
        if not conn: return {}
        cur = conn.cursor()
        query = """
            SELECT
                COUNT(w.workout_id) AS total_workouts,
                SUM(w.duration_minutes) AS total_duration,
                AVG(w.duration_minutes) AS avg_workout_duration,
                MIN(w.workout_date) AS first_workout_date,
                MAX(w.workout_date) AS last_workout_date
            FROM workouts w
            WHERE w.user_id = %s;
        """
        cur.execute(query, (user_id,))
        result = cur.fetchone()
        
        if result:
            col_names = [desc[0] for desc in cur.description]
            return dict(zip(col_names, result))
        return {}
    except (Exception, psycopg2.Error) as error:
        print(f"Error fetching insights: {error}")
        return {}
    finally:
        if cur: cur.close()
        if conn: conn.close()

# --- UPDATE Operations ---

def update_user_profile(user_id, name=None, email=None, weight=None):
    """Updates a user's profile information."""
    conn, cur = None, None
    try:
        conn = get_db_connection()
        if not conn: return False
        cur = conn.cursor()
        
        updates = []
        params = []
        if name is not None:
            updates.append("name = %s")
            params.append(name)
        if email is not None:
            updates.append("email = %s")
            params.append(email)
        if weight is not None:
            updates.append("weight = %s")
            params.append(weight)
        
        if not updates:
            return False # No fields to update

        params.append(user_id)
        query = f"UPDATE users SET {', '.join(updates)} WHERE user_id = %s;"
        cur.execute(query, tuple(params))
        conn.commit()
        return True
    except (Exception, psycopg2.Error) as error:
        print(f"Error updating user profile: {error}")
        if conn: conn.rollback()
        return False
    finally:
        if cur: cur.close()
        if conn: conn.close()

