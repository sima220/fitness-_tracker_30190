def log_new_workout(user_id, workout_date, duration_minutes, exercises: List[Dict]):
    """Logs a new workout and its exercises."""
    conn, cur = None, None
    try:
        conn = get_db_connection()
        if not conn: return None
        cur = conn.cursor()

        # Log workout first
        workout_query = "INSERT INTO workouts (user_id, workout_date, duration_minutes) VALUES (%s, %s, %s) RETURNING workout_id;"
        cur.execute(workout_query, (user_id, workout_date, duration_minutes))
        workout_id = cur.fetchone()[0]

        # Log exercises
        exercise_query = "INSERT INTO exercises (workout_id, exercise_name, sets, reps, weight) VALUES (%s, %s, %s, %s, %s);"
        for exercise in exercises:
            cur.execute(exercise_query, (workout_id, exercise['name'], exercise['sets'], exercise['reps'], exercise['weight']))
        
        conn.commit()
        return workout_id
    except (Exception, psycopg2.Error) as error:
        print(f"Error logging workout: {error}")
        if conn: conn.rollback()
        return None
    finally:
        if cur: cur.close()
        if conn: conn.close()

